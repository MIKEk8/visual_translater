# Environment configuration for Screen Translator v2.0

# Python paths
PYTHON_VENV=.venv/bin/python
PIP_VENV=.venv/bin/pip

# For Windows users
PYTHON_WENV=wenv/Scripts/python.exe
PIP_WENV=wenv/Scripts/pip.exe

# Default Python command for this environment
PYTHON_CMD=${PYTHON_VENV}
PIP_CMD=${PIP_VENV}