#[tauri::command]
pub async fn validate_hotkey_combination(hotkey: &str) -> Result<bool, String> {
    log::info!("Validating hotkey combination: {}", hotkey);
    // Basic validation - check if hotkey format is valid
    let is_valid = hotkey.contains('+') && !hotkey.is_empty();
    Ok(is_valid)
}

