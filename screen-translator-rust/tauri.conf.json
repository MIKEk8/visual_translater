{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "Screen Translator",
  "version": "3.0.0",
  "identifier": "com.screentranslator.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5174",
    "frontendDist": "dist"
  },

  "app": {
    "security": { "csp": null },
    "windows": [
      {
        "label": "main",
        "title": "Screen Translator",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "visible": true,
        "decorations": true,
        "resizable": true,
        "alwaysOnTop": false,
        "transparent": false,
        "devtools": true
      }
    ]
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "longDescription": "Advanced screen translation tool with OCR and AI-powered features",
    "shortDescription": "Screen translation tool with OCR"
  },

  "plugins": {}
}