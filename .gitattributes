# Git attributes for Screen Translator v2.0
# Force consistent line endings across platforms

# Set default behavior for all files
* text=auto eol=lf

# Explicitly declare text files to be normalized and converted to LF
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Denote binary files that should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Explicitly set line endings for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Set line endings for shell scripts
*.sh text eol=lf

# Set line endings for common web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.xml text eol=lf

# Set line endings for configuration files
.gitignore text eol=lf
.gitattributes text eol=lf
requirements*.txt text eol=lf
pyproject.toml text eol=lf
setup.py text eol=lf
setup.cfg text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf