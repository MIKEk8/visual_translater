[MASTER]
# Python code to execute (deprecated, use PYTHONPATH instead)
# init-hook='import sys; sys.path.append(".")'

# Files or directories to be skipped
ignore=CVS,build,dist,.venv,docs

# Use multiple processes to speed up Pylint
jobs=4

[MESSAGES CONTROL]
# Disable specific warnings
disable=
    C0111,  # missing-docstring (we use pydocstyle for this)
    C0103,  # invalid-name (sometimes we want short names like 'x', 'y')
    R0903,  # too-few-public-methods (sometimes valid for data classes)
    R0913,  # too-many-arguments (sometimes necessary)
    R0914,  # too-many-locals (can be valid in complex functions)
    W0212,  # protected-access (sometimes necessary for testing)
    W0703,  # broad-except (sometimes we want to catch all exceptions)
    E1101,  # no-member (false positives with dynamic attributes)
    R0902,  # too-many-instance-attributes (allowed in complex components)
    R1705,  # no-else-return (style preference)
    W0613,  # unused-argument (allowed for interface compatibility)
    C0415,  # import-outside-toplevel (allowed for optional deps)
    W0611,  # unused-import (allowed in optional import branches)
    E0202,  # method-hidden (acceptable in dataclass-like DTOs)
    E1121,  # too-many-function-args (legacy constructor patterns allowed)
    C0325,  # superfluous-parens (style)
    W0105,  # pointless-string-statement (module docstrings already present)
    W0511,  # fixme (TODO markers allowed for backlog)

[FORMAT]
# Maximum number of characters on a single line
max-line-length=130

# String used as indentation unit
indent-string='    '

[BASIC]
# Good variable names which should always be accepted
good-names=i,j,k,ex,x,y,_,app,ui,id

[DESIGN]
# Maximum number of arguments for function / method
max-args=10

# Maximum number of return statements in function / method body
max-returns=6

# Maximum number of public methods for a class
max-public-methods=25

# Maximum number of attributes for a class
max-attributes=15

[CLASSES]
# List of method names used to declare instance attributes
defining-attr-methods=__init__,__new__,setUp,__post_init__

[EXCEPTIONS]
# Exceptions that will emit a warning when being caught
overgeneral-exceptions=builtins.Exception